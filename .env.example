APP_NAME=Sansa AI
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://sansa:sansa@127.0.0.1:15432/sansa
# Must be at least 32 bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES_000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

LLM_PROVIDER=mock
LLM_API_KEY=PLACEHOLDER
LLM_BASE_URL=http://127.0.0.1:8001/v1
MODEL_NAME=gemma-4-26b-a4b-it

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

ACCESS_COOKIE_NAME=sansa_access
REFRESH_COOKIE_NAME=sansa_refresh
CSRF_COOKIE_NAME=sansa_csrf
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_HEADER_NAME=X-CSRF-Token

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=[".csv",".xlsx",".xls"]
INGESTION_WORKER_POLL_SECONDS=2.0
INGESTION_WORKER_BATCH_SIZE=1

SQL_ROW_LIMIT=10000
SQL_TIMEOUT_SECONDS=30
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RESPONSE_BYTES=10485760
WEBHOOK_ENC_KEY=hFyWwzX6ERzgTdMxdVwmEShHEbDmEMf-OFTnvjnCSrRt2B9_WtonnvT_nxu2zpLw

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSIONS=1024
RETRIEVAL_DEFAULT_TOP_K=10
RETRIEVAL_VECTOR_WEIGHT=0.5
RETRIEVAL_KEYWORD_WEIGHT=0.3
RETRIEVAL_SQL_WEIGHT=0.2
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
FASTEMBED_CACHE_DIR=
EMBEDDING_BATCH_SIZE=32

CHUNK_STRATEGY=continuity
CHUNK_HEADING_PREFIX=true

MAX_PDF_UPLOAD_BYTES=104857600
ALLOWED_UPLOAD_EXTENSIONS=[".csv",".xlsx",".xls",".pdf"]
PDF_MAX_PAGES=1000
PDF_MIN_CHARS_PER_PAGE=10